// =============================================================================
// Physical Constraints File (.cst) for Sipeed Tang Nano 9K
// Device: Gowin GW1NR-LV9QN88PC6/I5
// Board: Sipeed Tang Nano 9K
// =============================================================================

// Onboard 27 MHz Crystal Oscillator
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Onboard User Button S1 (Active-Low Hardware Reset)
IO_LOC "rst_n" 3;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Status & Activity Indicator LEDs
IO_LOC "gpu_busy" 10;
IO_PORT "gpu_busy" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// =============================================================================
// Onboard HDMI / DVI Physical Transmitter Differential Pairs
// =============================================================================
// TMDS Clock
// IO_LOC "tmds_clk_p" 69,68;
// IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;

// TMDS Data Channel 0 (Blue)
// IO_LOC "tmds_d0_p" 71,70;
// IO_PORT "tmds_d0_p" PULL_MODE=NONE DRIVE=8;

// TMDS Data Channel 1 (Green)
// IO_LOC "tmds_d1_p" 73,72;
